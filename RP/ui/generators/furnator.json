{
  "namespace": "furnator",
  "furnator_top": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [162, 72],
    "offset": [-10, -40],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "$show_machine_name|default": true,
    "$machine_screen_size|default": [52, 52],
    "$machine_screen_offset|default": [11, 14],
    "$status_offset|default": [14, 12],
    "$status_pocket_text_scale|default": 0.70,
    "$fuel_slot_size|default": [18, 18],
    "$fuel_item_size|default": [16, 16],
    "$fuel_item_panel_size|default": [18, 18],
    "variables": [
      {
        "requires": "$pocket_screen",
        "$fuel_slot_size": [28, 28],
        "$fuel_item_size": [24, 24],
        "$fuel_item_panel_size": [28, 28],
        "$machine_screen_size": [54, 52],
        "$machine_screen_offset": [5, 14],
        "$status_offset": [8, 12],
        "$status_pocket_text_scale": 0.58,
        "$show_machine_name": false
      }
    ],
    "controls": [
      {
        "machine_name@uc.machine_name": {
          "$show_machine_name": "$show_machine_name"
        }
      },
      {
        "energy_bar@uc.energy_bar": {
          "offset": [54, 0],
          "$has_bg": false
        }
      },
      {
        "machine_screen@uc.machine_small_screen": {
          "$screen_size": "$machine_screen_size",
          "$screen_offset": "$machine_screen_offset"
        }
      },
      {
        "machine_description@uc.machine_status_label": {
          "collection_index": 1,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "$status_offset",
          "$pocket_text_scale": "$status_pocket_text_scale"
        }
      },
      {
        "item@uc.fuel_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [10, 30],
          "collection_index": 3,
          "$slot_size": "$fuel_slot_size",
          "$item_size": "$fuel_item_size",
          "$item_panel_size": "$fuel_item_panel_size"
        }
      },
      {
        "machinery@uc.item_display": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [10, 48],
          "collection_index": 2
        }
      },
      {
        "io_tab@uc.io_tab": {
          "$pocket_io_toggle_offset": [105, 1],
          "$pocket_io_toggle_layer": 5,
          "$pocket_io_toggle_close_layer": 6,
          "$io_items_modes_description": "ui.utilitycraft:io.furnator.items",
          "$has_item_io": true,
          "$has_fluid_io": false,
          "$io_top_texture": "textures/ui/machine_faces/basic_furnator/32/up",
          "$io_left_texture": "textures/ui/machine_faces/basic_furnator/32/west",
          "$io_front_texture": "textures/ui/machine_faces/basic_furnator/32/north",
          "$io_right_texture": "textures/ui/machine_faces/basic_furnator/32/east",
          "$io_bottom_texture": "textures/ui/machine_faces/basic_furnator/32/down",
          "$io_back_texture": "textures/ui/machine_faces/basic_furnator/32/south",
          "$io_item_top_index": 4,
          "$io_item_left_index": 5,
          "$io_item_front_index": 6,
          "$io_item_right_index": 7,
          "$io_item_bottom_index": 8,
          "$io_item_back_index": 9
        }
      },
      {
        "info_tab@uc.info_tab": {
          "$pocket_info_toggle_offset": [105, 27],
          "$pocket_info_toggle_layer": 5,
          "$pocket_info_toggle_close_layer": 31,
          "$info_description": "ui.utilitycraft:info.furnator"
        }
      }
    ]
  },
  "pocket_panel@uc.pocket_machine_panel": {
    "$machine_top": "furnator.furnator_top"
  },
  "utility_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 40
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@uc.machine_root_panel": {
          "layer": 1,
          "controls": [
            {
              "pocket_background@uc.pocket_machine_background": {}
            },
            {
              "pocket_header@uc.pocket_machine_header": {}
            },
            {
              "pocket_inventory@uc.pocket_player_inventory": {}
            },
            {
              "pocket_divider@uc.pocket_machine_divider": {}
            },
            {
              "common_panel@uc.machine_common_panel": {}
            },
            {
              "chest_panel@uc.machine_chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "furnator_top@furnator.furnator_top": {}
                  },
                  {
                    "inventory_panel_bottom_half_with_label@uc.machine_inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@uc.machine_hotbar_grid_template": {}
                  },
                  {
                    "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  }
}
