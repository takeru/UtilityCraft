{
  "namespace": "crusher",
  "crusher_top": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [162, 72],
    "offset": [-10, -40],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "$energy_bar_offset|default": [-101, -13],
    "$energy_bar_bg_texture|default": "textures/ui/toggle_button/left_bg",
    "$right_machine_tabs_name|default": "right_machine_tabs",
    "$upgrade_toggle_control_name|default": "upgrade_toggle_button",
    "$io_toggle_control_name|default": "io_toggle_button",
    "$io_config_tabs_name|default": "io_config_tabs",
    "$io_items_toggle_control_name|default": "io_items_toggle_button",
    "$io_fluids_toggle_control_name|default": "io_fluids_toggle_button",
    "$info_toggle_control_name|default": "info_toggle_button",
    "$show_machine_name|default": true,
    "$machine_screen_size|default": [52, 52],
    "$machine_screen_offset|default": [11, 14],
    "$status_offset|default": [14, 12],
    "$status_pocket_text_scale|default": 0.70,
    "$progress_offset|default": [30, 23],
    "$progress_size|default": [34, 34],
    "$progress_item_size|default": [32, 32],
    "$input_offset|default": [4, 30],
    "$output_offset|default": [60, 26],
    "$input_slot_size|default": [18, 18],
    "$input_item_size|default": [16, 16],
    "$input_item_panel_size|default": [18, 18],
    "$output_slot_size|default": [26, 26],
    "$output_item_size|default": [16, 16],
    "$output_item_panel_size|default": [18, 18],
    "variables": [
      {
        "requires": "$pocket_screen",
        "$machine_screen_size": [54, 52],
        "$machine_screen_offset": [5, 14],
        "$status_offset": [8, 12],
        "$status_pocket_text_scale": 0.58,
        "$progress_offset": [38, 47],
        "$progress_size": [26, 26],
        "$progress_item_size": [24, 24],
        "$input_offset": [10, 50],
        "$output_offset": [66, 46],
        "$input_slot_size": [28, 28],
        "$input_item_size": [24, 24],
        "$input_item_panel_size": [28, 28],
        "$output_slot_size": [28, 28],
        "$output_item_size": [24, 24],
        "$output_item_panel_size": [28, 28],
        "$energy_bar_offset": [-13, 0],
        "$show_machine_name": false
      }
    ],
    "controls": [
      {
        "machine_name@uc.machine_name": {
          "$show_machine_name": "$show_machine_name"
        }
      },
      {
        "machine_screen@uc.machine_small_screen": {
          "layer": 1,
          "$screen_size": "$machine_screen_size",
          "$screen_offset": "$machine_screen_offset"
        }
      },
      {
        "energy_bar@uc.energy_bar": {
          "offset": "$energy_bar_offset",
          "$bar_bg_texture": "$energy_bar_bg_texture"
        }
      },
      {
        "machine_description@uc.machine_status_label": {
          "collection_index": 1,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "$status_offset",
          "$pocket_text_scale": "$status_pocket_text_scale"
        }
      },
      {
        "machinery@uc.progress_display": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": "$progress_offset",
          "collection_index": 2,
          "size": "$progress_size",
          "$cell_image_size": "$progress_size",
          "$item_renderer_panel_size": "$progress_size",
          "$item_renderer_size": "$progress_item_size"
        }
      },
      {
        "item@uc.input_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": "$input_offset",
          "collection_index": 3,
          "$slot_size": "$input_slot_size",
          "$item_size": "$input_item_size",
          "$item_panel_size": "$input_item_panel_size"
        }
      },
      {
        "item@uc.output_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": "$output_offset",
          "collection_index": 6,
          "$slot_size": "$output_slot_size",
          "$item_size": "$output_item_size",
          "$item_panel_size": "$output_item_panel_size"
        }
      },
      {
        "upgrades_tab@uc.upgrades_tab": {
          "$right_machine_tabs_name": "$right_machine_tabs_name",
          "$upgrade_toggle_control_name": "$upgrade_toggle_control_name",
          "$pocket_upgrade_toggle_offset": [105, -25],
          "$pocket_upgrade_toggle_layer": 5,
          "$pocket_upgrade_toggle_close_layer": 6
        }
      },
      {
        "io_tab@uc.io_tab": {
          "$right_machine_tabs_name": "$right_machine_tabs_name",
          "$io_toggle_control_name": "$io_toggle_control_name",
          "$io_config_tabs_name": "$io_config_tabs_name",
          "$io_items_toggle_control_name": "$io_items_toggle_control_name",
          "$io_fluids_toggle_control_name": "$io_fluids_toggle_control_name",
          "$pocket_io_toggle_offset": [105, 1],
          "$pocket_io_toggle_layer": 5,
          "$pocket_io_toggle_close_layer": 6,
          "$io_items_modes_description": "ui.utilitycraft:io.crusher.items",
          "$io_top_texture": "textures/ui/machine_faces/crusher/32/up",
          "$io_left_texture": "textures/ui/machine_faces/crusher/32/west",
          "$io_front_texture": "textures/ui/machine_faces/crusher/32/north",
          "$io_right_texture": "textures/ui/machine_faces/crusher/32/east",
          "$io_bottom_texture": "textures/ui/machine_faces/crusher/32/down",
          "$io_back_texture": "textures/ui/machine_faces/crusher/32/south",
          "$io_item_top_index": 7,
          "$io_item_left_index": 8,
          "$io_item_front_index": 9,
          "$io_item_right_index": 10,
          "$io_item_bottom_index": 11,
          "$io_item_back_index": 12
        }
      },
      {
        "info_tab@uc.info_tab": {
          "$right_machine_tabs_name": "$right_machine_tabs_name",
          "$info_toggle_control_name": "$info_toggle_control_name",
          "$pocket_info_toggle_offset": [105, 27],
          "$pocket_info_toggle_layer": 5,
          "$pocket_info_toggle_close_layer": 31,
          "$info_description": "ui.utilitycraft:info.crusher"
        }
      },
      {
        "recipe_overlays@uc.crusher_recipes_panel": {}
      }
    ]
  },
  "pocket_panel@uc.pocket_recipe_machine_panel": {
    "$machine_top": "crusher.crusher_top",
    "$recipe_side_panel": "uc.crusher_recipes_side_panel"
  },
  "utility_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 40
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@uc.machine_root_panel": {
          "layer": 1,
          "controls": [
            {
              "pocket_background@uc.pocket_machine_background": {}
            },
            {
              "pocket_header@uc.pocket_machine_header": {}
            },
            {
              "pocket_inventory@uc.pocket_player_inventory": {}
            },
            {
              "pocket_divider@uc.pocket_machine_divider": {}
            },
            {
              "chest_panel@uc.machine_chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "recipes_side_panel@uc.crusher_recipes_side_panel": {}
                  },
                  {
                    "recipes_connector@uc.crusher_recipes_connector": {}
                  },
                  {
                    "normal_content": {
                      "type": "panel",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "recipes_toggle_button",
                          "source_property_name": "(not (#toggle_state))",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": false
                        }
                      ],
                      "controls": [
                        {
                          "common_panel@uc.machine_common_panel": {
                            "$show_close_button": false
                          }
                        },
                        {
                          "view_top_bar@uc.machine_recipe_view_top_bar": {
                            "$machine_toggle_unchecked": "textures/ui/toggle_button/tab_pressed",
                            "$machine_toggle_checked": "textures/ui/toggle_button/tab_pressed",
                            "$machine_toggle_unchecked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$machine_toggle_checked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$recipes_toggle_checked": "textures/ui/toggle_button/tab",
                            "$recipes_toggle_checked_hover": "textures/ui/toggle_button/tab_hover"
                          }
                        },
                        {
                          "crusher_top@crusher.crusher_top": {}
                        },
                        {
                          "inventory_panel_bottom_half_with_label@uc.machine_inventory_panel_bottom_half_with_label": {}
                        },
                        {
                          "hotbar_grid@uc.machine_hotbar_grid_template": {}
                        },
                        {
                          "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                        }
                      ]
                    }
                  },
                  {
                    "recipes_content@uc.machine_recipes_content": {
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "recipes_toggle_button",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": false
                        }
                      ],
                      "controls": [
                        {
                          "common_panel@uc.machine_common_panel": {
                            "$show_close_button": false
                          }
                        },
                        {
                          "view_top_bar@uc.machine_recipe_view_top_bar": {
                            "$machine_toggle_default_state": false,
                            "$recipes_toggle_default_state": true,
                            "$machine_toggle_checked": "textures/ui/toggle_button/tab",
                            "$machine_toggle_checked_hover": "textures/ui/toggle_button/tab_hover",
                            "$recipes_toggle_unchecked": "textures/ui/toggle_button/tab_pressed",
                            "$recipes_toggle_checked": "textures/ui/toggle_button/tab_pressed",
                            "$recipes_toggle_unchecked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$recipes_toggle_checked_hover": "textures/ui/toggle_button/tab_hover_pressed"
                          }
                        },
                        {
                          "crusher_top@crusher.crusher_top": {
                            "$energy_bar_offset": [97, 64],
                            "$energy_bar_bg_texture": "textures/ui/toggle_button/right_bg",
                            "$right_machine_tabs_name": "right_machine_tabs_recipes",
                            "$upgrade_toggle_control_name": "upgrade_toggle_button_recipes",
                            "$io_toggle_control_name": "io_toggle_button_recipes",
                            "$io_config_tabs_name": "io_config_tabs_recipes",
                            "$io_items_toggle_control_name": "io_items_toggle_button_recipes",
                            "$io_fluids_toggle_control_name": "io_fluids_toggle_button_recipes",
                            "$info_toggle_control_name": "info_toggle_button_recipes"
                          }
                        },
                        {
                          "inventory_panel_bottom_half_with_label@uc.machine_inventory_panel_bottom_half_with_label": {}
                        },
                        {
                          "hotbar_grid@uc.machine_hotbar_grid_template": {}
                        },
                        {
                          "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  }
}
